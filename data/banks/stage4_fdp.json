          "id": "fdp_100",
          "points": 100,
          "stage_3_accessible": true,
          "question": "Write the fraction 18/24 in its simplest form.",
          "svg_prompt": null,
          "image": null,
          "accepted_answers": [
            "3/4"
          ],
          "worked_solution": "Divide numerator and denominator by their HCF of 6: 18 ÷ 6 = 3, 24 ÷ 6 = 4 → 3/4."
        },
        {
