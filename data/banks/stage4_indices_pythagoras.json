        {
          "id": "pyt_600",
          "points": 600,
          "stage_3_accessible": false,
          "question": "A right-angled triangle has a hypotenuse of 17 cm\nand a base of 15 cm.\nCalculate the AREA of the triangle (in cm²).",
          "svg_prompt": null,
          "image": null,
          "accepted_answers": [
            "60",
            "60cm2",
            "60 cm2",
            "60cm²"
          ],
          "worked_solution": "Height = √(17² − 15²) = √(289 − 225) = √64 = 8 cm. Area = ½ × 15 × 8 = 60 cm²."
