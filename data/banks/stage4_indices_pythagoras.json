          ],
          "worked_solution": "c² = 6² + 8² = 36 + 64 = 100 → c = √100 = 10 cm."
        },
        {
          "id": "pyt_450",
          "points": 450,
          "stage_3_accessible": false,
          "question": "A right-angled triangle has a hypotenuse of 13 cm\nand one shorter side of 5 cm.\nFind the length of the other shorter side (in cm).",
          "svg_prompt": null,
          "image": null,
          "accepted_answers": [
            "12",
            "12cm",
            "12 cm"
          ],
          "worked_solution": "a² = 13² − 5² = 169 − 25 = 144 → a = √144 = 12 cm."
        },
        {
          "id": "pyt_500",
          "points": 500,
          "stage_3_accessible": false,
          "question": "A 10 m ladder leans against a vertical wall\nwith its foot 6 m away from the base of the wall.\nHow high up the wall does the ladder reach (in m)?",
